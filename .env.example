# Environment Configuration
# Default: SQLite file for seamless local development
# For PostgreSQL: postgresql+psycopg2://employees:employees@localhost:5432/employees
DATABASE_URL=sqlite:///./employees.db

# Production secret key (min 32 bytes). Generate via:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key-change-me-in-production-min-32-chars

# JWT Settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application Settings
APP_ENV=development
APP_NAME="Employee Management System"
DEBUG=False
